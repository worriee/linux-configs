// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "VSCode",
  "line_ending": "enforce_crlf",
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "ensure_final_newline_on_save": true,
  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "breadcrumbs": true,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
  },
  "buffer_line_height": "comfortable",
  "diff_view_style": "split",
  "enable_language_server": false,
  "icon_theme": {
    "mode": "light",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "file_finder": {
    "include_ignored": "all",
  },
  "gutter": {
    "bookmarks": false,
    "folds": false,
    "runnables": false,
    "breakpoints": false,
  },
  "soft_wrap": "editor_width",
  "git": {
    "inline_blame": {
      "enabled": true,
    },
    "enable_status": true,
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "font_family": "JetBrains Mono",
    "button": true,
    "copy_on_select": true,
    "default_width": 500.0,
    "font_size": 13.0,
    "flexible": false,
    "dock": "right",
    "scrollbar": {
      "show": "never",
    },
  },
  "vim_mode": false,
  "helix_mode": false,
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "show_branch_name": true,
    "button_layout": "platform_default",
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "active_language_button": true,
    "show_active_file": true,
  },
  "ui_font_weight": 400.0,
  "text_rendering_mode": "platform_default",
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "proxy": "",
  "disable_ai": true,
  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 200,
    "hide_root": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "scrollbar": {
    "show": "auto",
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },
  "markdown_preview": {
    "limit_content_width": false,
  },
}
