{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "threshold": 0.8,
    "strategy": "summarize",
    "preserveRecentMessages": 10,
    "preserveSystemPrompt": true,
  },
  "provider": {
    "opencode": {
      "models": {
        "mimo-v2.5-free": {
          "limit": {
            "context": 1000000,
            "output": 128072,
          },
        },
      },
    },
  },
  "plugin": [
    "opencode-caveman",
    "@dietrichgebert/ponytail"
  ]
}
